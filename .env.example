# Sao chép thành .env rồi sửa các giá trị mẫu. KHÔNG commit .env.

# --- PostgreSQL (máy chạy script và backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=postgres
DB_PASSWORD=doi-mat-khau-postgres-cua-ban
# Tùy chọn: chuỗi kết nối đầy đủ, nếu đặt sẽ thay cho các biến DB_* ở trên
DATABASE_URL=
# Docker Compose: cổng PostgreSQL trên máy host (tránh trùng cổng 5432 đã dùng)
DB_HOST_PORT=5433

# --- Dữ liệu nạp ---
# Để trống: dùng data/raw/ nếu đủ 7 CSV case-study, ngược lại dùng bộ mẫu data/sample/
DATA_DIR=

# --- Ứng dụng ---
APP_PORT=8000
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự để ký token đăng nhập
SECRET_KEY=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# Mật khẩu chung của các tài khoản demo (QL_TT01…, KT002…)
DEMO_PASSWORD=doi-mat-khau-demo

# --- Kiểm thử tích hợp / hệ thống (tùy chọn) ---
# Database kiểm thử phải có tên kết thúc bằng _test
TEST_DB_NAME=smartcrm_test
TEST_DATABASE_URL=
UI_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# 1 = ghi thêm báo cáo export/testcase.md và ảnh của test UI giả lập
# EVIDENCE=1
# EXPORT_DIR=export
