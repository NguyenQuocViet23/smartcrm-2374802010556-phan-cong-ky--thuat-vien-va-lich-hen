# Stages: base -> test (unit tests) and base -> app (the service).
# `app` is deliberately the LAST stage, so a plain `docker build` or `docker compose build`
# without a target produces the service image, never the test image.
FROM python:3.12-slim AS base

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Run as an unprivileged user; it owns only what the app and the loaders write.
RUN useradd --create-home --uid 10001 app
COPY --chown=app:app db ./db
COPY --chown=app:app scripts ./scripts
COPY --chown=app:app src/backend ./src/backend
COPY --chown=app:app data/sample ./data/sample
RUN mkdir -p data/raw data/processed reports && chown -R app:app data reports

ENV PYTHONPATH=/app/src/backend
ENV PYTHONUNBUFFERED=1

# Unit tests inside Docker: `docker compose run --rm test`.
# The playwright package is only imported by the conftest files; no browser is downloaded.
FROM base AS test
COPY requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY --chown=app:app tests ./tests
COPY --chown=app:app pytest.ini ./
USER app
CMD ["python", "-m", "pytest", "-p", "no:cacheprovider"]

FROM base AS app
USER app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/db-check', timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
