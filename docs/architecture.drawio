        </mxCell>
        <mxCell id="c30" value="kết quả / lỗi nghiệp vụ&lt;br&gt;→ Router đổi thành HTTP 400·403·404·409" style="endArrow=block;dashed=1;labelBackgroundColor=#ffffff;fontSize=10;exitY=0;entryY=1;exitX=0.7;entryX=0.7;html=1;" parent="1" source="L2" target="L1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
