        </mxCell>
        <mxCell id="c32" value="đối tượng miền / kết quả ghi" style="endArrow=block;dashed=1;labelBackgroundColor=#ffffff;fontSize=10;exitY=0;entryY=1;exitX=0.7;entryX=0.7;html=1;" parent="1" source="L3" target="L2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="SQL (trong giao dịch&lt;br&gt;của Service)" style="endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;exitY=1;entryY=0;exitX=0.3;entryX=0.3;html=1;" parent="1" source="L3" target="L4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="dòng dữ liệu / lỗi ràng buộc" style="endArrow=block;dashed=1;labelBackgroundColor=#ffffff;fontSize=10;exitY=0;entryY=1;exitX=0.7;entryX=0.7;html=1;" parent="1" source="L4" target="L3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="CHÚ THÍCH&lt;br&gt;▭ bo góc = thành phần (lớp, service, repository)&lt;br&gt;[Mx] = màn hình wireframe (mục 5)&lt;br&gt;Mũi tên liền ↓ = phụ thuộc MỘT CHIỀU: lớp trên gọi lớp dưới&lt;br&gt;Mũi tên đứt ↑ = kết quả/lỗi trả lên; lớp dưới KHÔNG BAO GIỜ gọi lớp trên&lt;br&gt;Nhãn trên mũi tên = cách hai lớp trao đổi&lt;br&gt;UCx, QT-xx, Ax, NFRx = tham chiếu về SRS&lt;br&gt;Hình trụ = bảng trong ERD (tên khớp erd.drawio)" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=#666666;spacing=6;html=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="50" width="310" height="215" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="NGOÀI PHẠM VI (WON&#39;T)&lt;br&gt;W1 Tạo phiếu, phân loại sự cố, ưu tiên (L2)&lt;br&gt;W2 Tồn kho, xuất linh kiện (L5)&lt;br&gt;W3 Đóng/hủy phiếu, khảo sát hài lòng (L2/L8)&lt;br&gt;W4 Nhắc lịch hẹn qua SMS/Zalo&lt;br&gt;W5 Tự chuyển phiếu sang trung tâm khác&lt;br&gt;W6 Báo cáo quá hạn toàn công ty (L6)&lt;br&gt;W7 Tối ưu lộ trình kỹ thuật viên" style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#555555;spacing=6;html=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="285" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="ĐÓNG GÓI (NFR5): docker-compose, 3 container" style="text;fontStyle=1;fontSize=10;align=left;html=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="465" width="310" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="web&lt;br&gt;React SPA&lt;br&gt;(Vite)" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#333333;dashed=1;html=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="492" width="98" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="api&lt;br&gt;FastAPI&lt;br&gt;(Python 3.11+)" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#333333;dashed=1;html=1;" parent="1" vertex="1">
          <mxGeometry x="935" y="492" width="98" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="db&lt;br&gt;PostgreSQL 16" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#ffffff;strokeColor=#333333;dashed=1;html=1;" parent="1" vertex="1">
          <mxGeometry x="1040" y="492" width="98" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="Đọc độc lập: yêu cầu &quot;Phân công kỹ thuật viên&quot; đi M2 → AssignmentRouter → AssignmentService (kiểm QT-08, mở giao dịch) → TicketRepository + TicketStatusLogRepository → ticket, ticket_status_log. Lỗi vi phạm quy tắc đi ngược lên thành HTTP 400/409 và hiển thị trong vùng thông báo của M2." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=#999999;spacing=6;html=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="580" width="310" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
