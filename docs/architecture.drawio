        <mxCell id="c28" value="Khóa ngoại: ticket→service_center, ticket→technician, technician→service_center, technician_skill→technician, appointment→ticket, appointment→technician, ticket_status_log→ticket" style="text;whiteSpace=wrap;fontSize=10;align=left;html=1;" parent="1" vertex="1">
          <mxGeometry x="55" y="845" width="735" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="gọi hàm + DTO + CurrentUser&lt;br&gt;(vai trò, trung tâm)" style="endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;exitY=1;entryY=0;exitX=0.3;entryX=0.3;html=1;" parent="1" source="L1" target="L2" edge="1">
