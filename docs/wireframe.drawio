tStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="160" height="36" as="geometry"/></mxCell><mxCell id="c58" value="17" style="ellipse;whiteSpace=wrap;fillColor=#e51400;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="662" width="20" height="20" as="geometry"/></mxCell><mxCell id="c59" value="Lịch hẹn của phiếu" style="text;fontStyle=1;fontSize=11;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="300" height="22" as="geometry"/></mxCell><mxCell id="c60" value="Giờ" style="rounded=0;whiteSpace=wrap;fillColor=#e0e0e0;strokeColor=#666666;fontSize=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="250" height="26" as="geometry"/></mxCell><mxCell id="c61" value="Loại" style="rounded=0;whiteSpace=wrap;fillColor=#e0e0e0;strokeColor=#666666;fontSize=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="748" width="120" height="26" as="geometry"/></mxCell><mxCell id="c62" value="Trạng thái" style="rounded=0;whiteSpace=wrap;fillColor=#e0e0e0;strokeColor=#666666;fontSize=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="410" y="748" width="150" height="26" as="geometry"/></mxCell><mxCell id="c63" value="16" style="ellipse;whiteSpace=wrap;fillColor=#e51400;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="744" width="20" height="20" as="geometry"/></mxCell><mxCell id="c64" value="06/10 09:00–09:30" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aaaaaa;fontSize=10;align=left;spacingLeft=3;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="774" width="250" height="26" as="geometry"/></mxCell><mxCell id="c65" value="NHẬN" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aaaaaa;fontSize=10;align=left;spacingLeft=3;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="774" width="120" height="26" as="geometry"/></mxCell><mxCell id="c66" value="ĐÃ HẸN" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aaaaaa;fontSize=10;align=left;spacingLeft=3;html=1;" vertex="1" parent="1"><mxGeometry x="410" y="774" width="150" height="26" as="geometry"/></mxCell><mxCell id="c67" value="04/10 14:00–14:30" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aaaaaa;fontSize=10;align=left;spacingLeft=3;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="250" height="26" as="geometry"/></mxCell><mxCell id="c68" value="GIAO" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aaaaaa;fontSize=10;align=left;spacingLeft=3;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="800" width="120" height="26" as="geometry"/></mxCell><mxCell id="c69" value="ĐÃ HỦY" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#aaaaaa;fontSize=10;align=left;spacingLeft=3;html=1;" vertex="1" parent="1"><mxGeometry x="410" y="800" width="150" height="26" as="geometry"/></mxCell><mxCell id="c70" value='EX-6.6 và EX-6.5 minh họa hai tình huống thay thế; biểu mẫu lịch hẹn cũng được Quản lý trung tâm mở từ nút "Đặt lịch hẹn" ở M2 (UC6).' style="text;whiteSpace=wrap;fontSize=10;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="820" height="36" as="geometry"/></mxCell><mxCell id="c71" value="CHÚ THÍCH: ● đỏ có số = trường dữ liệu, tra cột tương ứng ở bảng đối chiếu (mục 5 báo cáo) · khung đỏ nét đứt = chỗ hiển thị lỗi/ngoại lệ (mã EX-…) · khung vàng nét đứt = cảnh báo · nút xanh = hành động ứng với use case. Các khung EX-… là vùng thông báo xuất hiện tùy tình huống, không hiện cùng lúc." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=#999999;spacing=5;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1085" width="960" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>