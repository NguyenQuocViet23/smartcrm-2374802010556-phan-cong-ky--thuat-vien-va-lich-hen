se;whiteSpace=wrap;fillColor=#e51400;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;html=1;" vertex="1" parent="1"><mxGeometry x="830" y="326" width="20" height="20" as="geometry"/></mxCell><mxCell id="c49" value="Quy ước hiển thị: sắp CAO → TRUNG_BINH → THAP, cùng mức thì hạn cam kết gần hơn lên trước (A4). Nhãn QUÁ HẠN tính từ due_date so với giờ hiện tại." style="text;whiteSpace=wrap;fontSize=10;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="810" height="40" as="geometry"/></mxCell><mxCell id="c50" value="CHÚ THÍCH: ● đỏ có số = trường dữ liệu, tra cột tương ứng ở bảng đối chiếu (mục 5 báo cáo) · khung đỏ nét đứt = chỗ hiển thị lỗi/ngoại lệ (mã EX-…) · khung vàng nét đứt = cảnh báo · nút xanh = hành động ứng với use case. Hai dòng EX-1.1 và EX-1.2 là hai trạng thái thay thế vùng bảng/dải trên cùng, không hiện cùng lúc với dữ liệu." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;strokeColor=#999999;spacing=5;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="960" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="M2 Phan cong KTV"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="M2 – Phân công / đổi kỹ thuật viên cho phiếu (Quản lý trung tâm · UC2, UC3, UC4, mở UC6)" style="text;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="22" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="32" width="960" height="960" as="geometry"/></mxCell><mxCell id="c4" value="Smart CRM · Mekong Mobile        Phân công kỹ thuật viên        Trung tâm: Quận 10" style="